; /VSYNC on SET pin (GPIO 3). Idle high, 4-line active-low pulse.
; Paced by IRQ 0 from hsync. One wrap = 402 lines (12.813 ms, 78.041 Hz).
;
; Frame: 338 active + 12 front porch + 4 sync + 48 back porch = 402.
; IRQ 2 at wrap: rewind the DMA line-pointer table (once per frame).

.program vsync

.wrap_target
    set pins, 1
    set x, 11                       ; 12 * 32 = 384 waits
high_outer:
    set y, 31
high_inner:
    wait 1 irq 0
    jmp y-- high_inner
    jmp x-- high_outer
    set x, 13                       ; 14 more waits → 398 high lines
high_remain:
    wait 1 irq 0
    jmp x-- high_remain

    set pins, 0
    set x, 3                        ; 4 low lines
low_lines:
    wait 1 irq 0
    jmp x-- low_lines
    irq 2                           ; DMA rewind; not a wait
.wrap
