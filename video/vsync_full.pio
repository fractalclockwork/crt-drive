; /VSYNC on SET pin (GPIO 3). Idle high, 6-line active-low pulse.
; Paced by IRQ 0 from hsync. One wrap = 434 lines.
;
; fH is 31.329 kHz, so this frame is 72.2 Hz. Longer than the factory
; 402-line / 78.0 Hz wrap, so the vertical ramp has time to reach the
; 60 Hz glass. Back porch stays 8 lines (the retrace guard). cross60
; keeps video/vsync.pio at 402.
;
; DMA split: 8 BP + 416 active + 4 FP + 6 sync.
; IRQ 2 at wrap: rewind the DMA line-pointer table (once per frame).

.program vsync

.wrap_target
    set pins, 1
    set x, 12                       ; 13 * 32 = 416 waits
high_outer:
    set y, 31
high_inner:
    wait 1 irq 0
    jmp y-- high_inner
    jmp x-- high_outer
    set x, 11                       ; 12 more waits → 428 high lines
high_remain:
    wait 1 irq 0
    jmp x-- high_remain

    set pins, 0
    set x, 5                        ; 6 low lines
low_lines:
    wait 1 irq 0
    jmp x-- low_lines
    irq 2                           ; DMA rewind; not a wait
.wrap
